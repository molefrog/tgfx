{
  "name": "@molefrog/tgfx",
  "version": "0.3.0",
  "description": "Run a local fx agent through Telegram",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/molefrog/tgfx.git"
  },
  "homepage": "https://github.com/molefrog/tgfx#readme",
  "bugs": "https://github.com/molefrog/tgfx/issues",
  "keywords": [
    "telegram",
    "fx",
    "ai",
    "coding-agent",
    "cli"
  ],
  "type": "module",
  "scripts": {
    "build": "cargo build --locked --release",
    "dev": "cargo run --locked --",
    "start": "cargo run --locked --",
    "check": "cargo fmt --all --check && cargo clippy --locked --all-targets -- -D warnings",
    "test": "cargo test --locked --all-targets",
    "test:parity": "cargo build --locked --example conformance && bun scripts/check-rust-parity.ts",
    "verify": "sh scripts/check-rust.sh",
    "install:local": "sh scripts/install.sh"
  },
  "devDependencies": {
    "@agentclientprotocol/sdk": "^1.4.0",
    "@clack/prompts": "1.7.0",
    "@modelcontextprotocol/sdk": "1.30.0",
    "@types/bun": "latest",
    "@types/qrcode-terminal": "^0.12.2",
    "@types/react": "19",
    "grammy": "1.46.0",
    "ink": "7.1.1",
    "ink-testing-library": "4.0.0",
    "marked": "18.0.11",
    "qrcode-terminal": "^0.12.0",
    "react": "19.2.8",
    "typescript": "latest",
    "zod": "4.4.3"
  },
  "private": true
}
