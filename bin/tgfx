#!/bin/sh
set -eu
root=$(CDPATH='' cd -- "$(dirname -- "$0")/.." && pwd)
# Development helper. Installed and release builds are the native executable.
target=${CARGO_TARGET_DIR:-"$root/target"}
case "$target" in /*) ;; *) target="$root/$target" ;; esac
for profile in release debug; do
  if [ -x "$target/$profile/tgfx" ]; then
    exec "$target/$profile/tgfx" "$@"
  fi
done
echo 'Build TGFX first: cargo build --release --locked' >&2
exit 1
