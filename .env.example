# Create a bot with @BotFather, then paste its token here.
TELEGRAM_BOT_TOKEN=123456789:replace_me

# Recommended: only these Telegram user IDs may start local FX sessions.
# TELEGRAM_ALLOWED_USER_IDS=123456789

# Optional: change how frequently the visible draft is refreshed.
# Keep this at 800ms or higher to stay below Telegram's 40 calls / 30s limit.
STREAM_UPDATE_MS=800

# Optional FX ACP process overrides.
FX_BINARY=fx
# FX_ACP_MODEL=openai/gpt-5.4
# FX_ACP_LOG_DIR=logs/acp
